# ==============================================================================
# Environment Configuration - Infrastructure Log Anomaly Detection Platform
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development
APP_NAME="LogPulse AnomalyGuard"
DEBUG=true
LOG_LEVEL=INFO

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Streamlit Dashboard Configuration
DASHBOARD_PORT=8501

# Database Configuration (PostgreSQL in production; SQLite fallback for local test)
# PostgreSQL example: postgresql+asyncpg://postgres:postgres@localhost:5432/log_anomaly_db
DATABASE_URL=sqlite+aiosqlite:///./data/logpulse.db
DB_ECHO=false

# Drain3 Online Log Parser Configuration
DRAIN3_SIM_TH=0.5
DRAIN3_DEPTH=4
DRAIN3_MAX_CHILDREN=100
DRAIN3_STATE_FILE=./data/drain3_state.bin

# Feature Engineering Configuration
FEATURE_WINDOW_SIZE=60
FEATURE_SLIDING_STEP=10
SEQUENCE_LENGTH=20

# Anomaly Detection & Model Settings
DEFAULT_DETECTOR=isolation_forest
ISOLATION_FOREST_CONTAMINATION=0.01
DEEPLOG_TOP_K=9
DEEPLOG_HIDDEN_SIZE=64
DEEPLOG_NUM_LAYERS=2
DEEPLOG_EMBEDDING_DIM=32

# Alerting & Incident Correlation
ALERT_COOLDOWN_SECONDS=300
INCIDENT_CORRELATION_WINDOW_SECONDS=600
MIN_ALERT_SEVERITY=MEDIUM

# Prometheus Metrics Exporter
PROMETHEUS_ENABLED=true
