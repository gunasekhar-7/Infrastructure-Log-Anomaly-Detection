# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Data directories (keep 2k benchmark samples & processed data; ignore huge downloads)
data/raw/**/*.tar.gz
data/raw/**/*.zip
data/raw/**/HDFS.log
data/raw/**/BGL.log
data/synthetic/*
!data/synthetic/.gitkeep

# Model checkpoints and serialization artifacts
models/checkpoints/*
!models/checkpoints/.gitkeep
*.pt
*.pth
*.joblib
*.pkl

# Databases and persistent stores
*.sqlite
*.sqlite3
*.db
*.drain3state

# IDEs and OS files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs and test outputs
*.log
